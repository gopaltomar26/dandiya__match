rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to your own Google email
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'you@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid;
      allow delete: if isOwner();
    }

    // Phone numbers: only the owner of the profile, the admin, or a mutual match can read
    match /phones/{uid} {
      allow read: if request.auth.uid == uid
        || isOwner()
        || (signedIn()
            && exists(/databases/$(database)/documents/likes/$(uid + '_' + request.auth.uid))
            && exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + uid)));
      allow create, update: if request.auth.uid == uid;
      allow delete: if isOwner();
    }

    match /likes/{id} {
      allow read: if signedIn();
      allow create: if request.auth.uid == request.resource.data.from
        && id == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if resource.data.from == request.auth.uid || isOwner();
    }
  }
}
